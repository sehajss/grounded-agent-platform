APP_ENV=local
APP_LOG_LEVEL=INFO

# Local PostgreSQL exposed by Docker Compose on host port 5433.
DATABASE_URL=postgresql+asyncpg://grounded_agent:grounded_agent@localhost:5433/grounded_agent

# Replace this before using the app beyond local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Add your Groq key when you’re ready to run model-backed features.
GROQ_API_KEY=
GROQ_MODEL=

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8

# Developer-agent safeguards
AGENT_ALLOW_WRITES=false
AGENT_MAX_STEPS=8
AGENT_MAX_WRITE_BYTES=100000
AGENT_ALLOWED_CHECKS=pytest,ruff,mypy
